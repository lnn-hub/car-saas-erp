# Frontend тохиргоо. Хуулж .env.local болгоно: cp .env.example .env.local
# Production (Vercel) дээр Settings → Environment Variables хэсэгт тавина.

# Backend API хаяг
NEXT_PUBLIC_API_URL=http://localhost:4001

# Сайтын үндсэн хаяг (OG зураг, sitemap). Vercel дээр хоосон бол production хаягийг өөрөө авна.
NEXT_PUBLIC_SITE_URL=

# Танилцуулгын горим: true бол "Админ" товч нууц үггүй шууд оруулна (backend-ийн DEMO_LOGIN-тэй хамт)
NEXT_PUBLIC_DEMO_LOGIN=

# Локал сайтыг утаснаас шалгахад Mac-ийн IP (зөвхөн next dev), жишээ: 172.20.10.2
DEV_ORIGIN=
