# Backend тохиргоо. Хуулж .env болгоод утгуудаа бөглөнө: cp .env.example .env
# Production (Render) дээр эдгээрийг Environment хэсэгт тавина. Нууц утгыг хэзээ ч git-д оруулахгүй.

# Сервер ажиллах порт (Render өөрөө тавина)
PORT=4001

# PostgreSQL холболт. Локал: postgresql://localhost:5432/car_saas_db  Production: Neon-ий хаяг
DATABASE_URL=postgresql://localhost:5432/car_saas_db

# Нэвтрэлтийн token-ийг гарын үсэглэх нууц түлхүүр (32+ тэмдэгт). Үүсгэх: openssl rand -base64 48
JWT_SECRET=

# Backend руу хандахыг зөвшөөрөх frontend хаяг(ууд), таслалаар тусгаарлана
FRONTEND_URL=http://localhost:3000

# Facebook постонд орох сайтын хаяг (заавал биш, хоосон бол FRONTEND_URL-аас авна)
PUBLIC_SITE_URL=

# Зураг хадгалах Cloudinary. Хоосон бол зураг локал backend/uploads хавтаст хадгалагдана (зөвхөн хөгжүүлэлтэд)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Facebook Graph API хувилбар (заавал биш), жишээ: v23.0
FB_GRAPH_VERSION=

# Танилцуулгын горим: true бол админ руу нууц үггүй орно. Бодит ашиглалтад ЗААВАЛ хоосон/false байна.
DEMO_LOGIN=
